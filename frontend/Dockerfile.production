# syntax=docker/dockerfile:1
FROM node:22-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci

COPY . .
ARG VITE_SENTRY_DSN=""
ARG VITE_SENTRY_ENVIRONMENT="production"
ARG VITE_SENTRY_RELEASE=""
ARG VITE_SENTRY_TRACES_SAMPLE_RATE="0.05"
ARG VITE_GTAG_ID=""
ARG VITE_GOOGLE_ADS_ID=""
ARG VITE_GOOGLE_ADS_CONVERSION_LABEL=""
ARG VITE_GTM_ID=""
ARG VITE_META_PIXEL_ID=""
ARG VITE_TIKTOK_PIXEL_ID=""
ENV VITE_SENTRY_DSN=$VITE_SENTRY_DSN \
    VITE_SENTRY_ENVIRONMENT=$VITE_SENTRY_ENVIRONMENT \
    VITE_SENTRY_RELEASE=$VITE_SENTRY_RELEASE \
    VITE_SENTRY_TRACES_SAMPLE_RATE=$VITE_SENTRY_TRACES_SAMPLE_RATE \
    VITE_GTAG_ID=$VITE_GTAG_ID \
    VITE_GOOGLE_ADS_ID=$VITE_GOOGLE_ADS_ID \
    VITE_GOOGLE_ADS_CONVERSION_LABEL=$VITE_GOOGLE_ADS_CONVERSION_LABEL \
    VITE_GTM_ID=$VITE_GTM_ID \
    VITE_META_PIXEL_ID=$VITE_META_PIXEL_ID \
    VITE_TIKTOK_PIXEL_ID=$VITE_TIKTOK_PIXEL_ID
RUN npm run build

FROM nginx:1.30-alpine

COPY nginx.production.conf /etc/nginx/nginx.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
