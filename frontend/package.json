{
  "name": "pdl-pro-frontend",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/ensure-l2-icons.mjs",
    "dev": "vite",
    "prebuild": "node scripts/ensure-l2-icons.mjs",
    "build": "tsc -b tsconfig.app.json && vite build",
    "icons": "node scripts/import-l2-icons.mjs && node scripts/pack-l2-icons.mjs",
    "icons:ensure": "node scripts/ensure-l2-icons.mjs",
    "icons:pack": "node scripts/pack-l2-icons.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@hcaptcha/react-hcaptcha": "^2.2.0",
    "@tanstack/react-query": "^5.100.10",
    "lucide-react": "^0.577.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "7.18.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.5"
  }
}
