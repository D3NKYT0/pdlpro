#: .\apps\auction\presentation\views\customer.py:81
msgid "Listar meus leilões"
msgstr "List my auctions"

#: .\apps\auction\presentation\views\customer.py:82
msgid "Lista os leilões criados pelo usuário autenticado."
msgstr "Lists the auctions created by the authenticated user."

#: .\apps\auction\presentation\views\customer.py:90
msgid "Criar leilão"
msgstr "Auction"

#: .\apps\auction\presentation\views\customer.py:91
