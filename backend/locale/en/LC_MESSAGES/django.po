#: .\apps\communication\presentation\views\push.py:66
msgid "Chave pública VAPID"
msgstr "VAPID public key"

#: .\apps\communication\presentation\views\push.py:67
msgid "Retorna a chave pública VAPID usada para assinar notificações Web Push."
msgstr "Returns the VAPID public key used to sign Web Push notifications."

#: .\apps\communication\presentation\views\push.py:85
msgid "Assinar push"
msgstr "Subscribe to push"

#: .\apps\communication\presentation\views\push.py:86
msgid "Registra a assinatura Web Push do navegador para o usuário autenticado."
