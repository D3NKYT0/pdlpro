# --- Django ------------------------------------------------------------------
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string-at-least-50-chars
# Fallbacks temporários do Django (CSV) após soft-rotate. Remova com --prune-secret-fallbacks.
SECRET_KEY_FALLBACKS=
SECRET_KEY_ROTATED_AT=
# 0 = desligado. Ex.: 90 agenda rotação automática via Celery Beat (pedido ou apply se permitido).
SECRET_KEY_AUTO_ROTATE_DAYS=0
SECRET_KEY_FALLBACK_TTL_DAYS=7
# Fernet (URL-safe Base64 de 32 bytes). Produção exige valor forte gerado pelo configurador.
PDL_DATA_ENCRYPTION_KEY=
PDL_DATA_ENCRYPTION_KEY_FALLBACKS=
# HMAC estável dos códigos de recuperação 2FA; não rotaciona com a Fernet.
PDL_DATA_HMAC_KEY=
PDL_DATA_ENCRYPTION_ROTATED_AT=
# AES-256 dos dumps em ./setup.sh backup. Produção: gere com configure-production.
BACKUP_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY_FALLBACKS=
# true = painel/Beat podem gravar o .env deste processo (só com .env montado e gravável).
PDL_ALLOW_RUNTIME_SECRET_ROTATION=false
# SECRET_MAINTENANCE_ENABLED=true
DJANGO_SETTINGS_MODULE=core.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost
OPENAPI_DOCS_PUBLIC=false

# Extensões de cliente (AppConfig sob extensions.*). Vazio no core.
# Exemplo: PDL_EXTENSION_APPS=extensions._example.apps.ExampleExtensionConfig
# Guia: docs/arquitetura/extensoes.md
# PDL_EXTENSION_APPS=

# --- Observabilidade ---------------------------------------------------------
# Em producao, LOG_FORMAT usa json por padrao; no desenvolvimento, console.
LOG_LEVEL=INFO
# APP_LOG_LEVEL=DEBUG
# LOG_FORMAT=console
# SERVICE_NAME=pdl-backend
# LOG_ENVIRONMENT=development
# Arquivos .log apenas em backend/log/ (e frontend/log/ no Vite). Em desenvolvimento
# LOG_TO_FILE já vem ligado; em producao o padrao e stdout (Docker/coletores).
# LOG_TO_FILE=true
# LOG_DIR=log
# LOG_FILE_MAX_BYTES=10485760
# LOG_FILE_BACKUP_COUNT=5
AUDIT_LOG_RETENTION_DAYS=365
WEBHOOK_LOG_RETENTION_DAYS=90
# Alertas e tracing opcionais (desativados quando o DSN estiver vazio).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05

# --- Database (PDL) ----------------------------------------------------------
# Local: sqlite. Docker Compose sobrescreve com postgres://pdl:pdl@db:5432/pdl
DATABASE_URL=sqlite:///db.sqlite3
DB_NAME=pdl
DB_USER=pdl
DB_PASSWORD=pdl

# --- Redis -------------------------------------------------------------------
# Em producao o Compose exige REDIS_PASSWORD e monta REDIS_URL com ela; o configurador
# gera a senha. Deixe vazio apenas em desenvolvimento, onde o Redis nao e publicado.
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# --- Arquivos privados -------------------------------------------------------
# Fora de MEDIA_ROOT: guarda o pacote de portabilidade LGPD, que so sai pela API
# com token assinado. Nao aponte para uma pasta servida pelo Nginx.
PRIVATE_MEDIA_ROOT=

# --- Mídia S3 / Cloudflare R2 (também no painel Integrações) -----------------
# Compatível com R2: endpoint + region=auto + checksums legacy (when_required).
USE_S3=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=auto
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_PRIVATE_MEDIA=false
AWS_QUERYSTRING_EXPIRE=3600
AWS_LOCATION=media

# --- Lineage 2 game database -------------------------------------------------
LINEAGE_DB_ENABLED=false
LINEAGE_DB_HOST=127.0.0.1
LINEAGE_DB_PORT=3306
LINEAGE_DB_NAME=l2jdb
LINEAGE_DB_USER=l2user
LINEAGE_DB_PASSWORD=
# TLS até o MySQL do jogo: false = conexão atual (sem SSL); true = TLS.
# Guia: docs/integracoes/lineage-mysql-ssl.md
LINEAGE_DB_SSL=false
LINEAGE_DB_SSL_VERIFY=true
LINEAGE_DB_SSL_CA=
LINEAGE_DB_SSL_CERT=
LINEAGE_DB_SSL_KEY=
LINEAGE_QUERY_MODULE=lucerav2
# Overlay/dialeto da extensão: ver docs/arquitetura/extensoes.md
# LINEAGE_PASSWORD_ALGO=whirlpool
# Pasta data/xml/items do servidor; itens ausentes ou com tradeable=false nao podem ser retirados.
LINEAGE_ITEM_XML_DIR=data/items
LINEAGE_SKILL_XML_DIR=data/skills
LINEAGE_DB_POOL_SIZE=2
LINEAGE_DB_MAX_OVERFLOW=4

# --- Game server status ------------------------------------------------------
GAME_SERVER_IP=127.0.0.1
GAME_SERVER_PORT=7777
LOGIN_SERVER_PORT=2106
SERVER_STATUS_TIMEOUT=2
FAKE_PLAYERS_FACTOR=1
FAKE_PLAYERS_MIN=0
FAKE_PLAYERS_MAX=0

# --- Frontend (Vite) ---------------------------------------------------------
VITE_API_BASE_URL=/api/v1
VITE_APP_TITLE=PDL PRO
VITE_HCAPTCHA_SITEKEY=
VITE_GOOGLE_CLIENT_ID=
VITE_DISCORD_CLIENT_ID=
VITE_DISCORD_URL=
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05
VITE_TRAILER_YOUTUBE_ID=Mm19W1PKMFQ
VITE_SERVER_NAME=
VITE_SERVER_DESCRIPTION=
# Extensões SPA: IDs das pastas em frontend/src/extensions/ (sem editar o router).
# Ex.: VITE_PDL_EXTENSIONS=example
# VITE_PDL_EXTENSIONS=

# --- Project -----------------------------------------------------------------
PROJECT_TITLE=PDL PRO
PROJECT_DESCRIPTION=Painel Definitivo Lineage 2.0
SITE_SEO_TITLE=
SITE_SEO_DESCRIPTION=
SITE_OG_IMAGE=
DISCORD_URL=
TRAILER_YOUTUBE_ID=
SERVER_CHRONICLE=Interlude
XP_RATE=x1
SP_RATE=x1
ADENA_RATE=x1
DROP_RATE=x1
SPOIL_RATE=x1
ENCHANT_SAFE=+3
ENCHANT_MAX=+16
MAX_LEVEL=80
SERVER_FEATURES=PvP e guerras de castelo,Eventos periodicos,Loja e marketplace no painel
PROJECT_URL=http://localhost
FRONTEND_URL=http://localhost:3000
DOMAIN=pdl.denky.dev.br
APP_BIND_ADDRESS=0.0.0.0
APP_HTTP_PORT=8080
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=PDL PRO
WEBAUTHN_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LEGAL_DOCS_VERSION=2026-09-10
# Identidade do controlador LGPD (preencha com os dados reais do operador do servidor)
# LEGAL_CONTROLLER_NAME=Operador do servidor
# LEGAL_TRADE_NAME=PDL PRO
# LEGAL_CNPJ=00.000.000/0000-00
# LEGAL_ADDRESS=Brasil
# LEGAL_CONTACT_EMAIL=contato@example.com
# LEGAL_DPO_EMAIL=dpo@example.com
# LEGAL_LEGAL_EMAIL=juridico@example.com
# LEGAL_FORUM=Brasil

# Web Push (somente envio de notificacoes; nao e PWA instalavel)
# Gere o par VAPID com: python -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); print(v.public_key.decode()); print(v.private_key.decode())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@localhost

# --- Auth cookies ------------------------------------------------------------
# JWT_AUTH_COOKIE=PDL-auth
# JWT_AUTH_REFRESH_COOKIE=PDL-refresh

# --- Payments ----------------------------------------------------------------
PAYMENT_METHODS=mercadopago,stripe
PAYMENT_ALLOW_MOCK=false
PAYMENT_MOCK_AUTO_CONFIRM=false
PAYMENT_WEBHOOK_BASE_URL=http://localhost:8000
COINS_PER_USD=5.00
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_ACTIVATE_PAYMENTS=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ACTIVATE_PAYMENTS=false

# --- Email -------------------------------------------------------------------
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@localhost

# --- Docker ------------------------------------------------------------------
GUNICORN_RELOAD=true
RUN_MIGRATIONS=true
RUN_COLLECTSTATIC=false
# Imagens publicadas (instalador / GHCR). Vazio = build local pdl_backend:local.
# PDL_IMAGE_REGISTRY=ghcr.io/d3nkyt0/pdlpro
# PDL_IMAGE_TAG=
# PDL_BACKEND_IMAGE=
# PDL_WEB_IMAGE=
# PDL_IMAGE_PULL_POLICY=never

# Denkynho — geração: desligada, Ollama local ou API remota (OpenAI-compatível).
DENKYNHO_LLM_ENABLED=false
DENKYNHO_LLM_PROVIDER=ollama
DENKYNHO_EMBEDDINGS_ENABLED=true
DENKYNHO_OLLAMA_URL=http://127.0.0.1:11434
# docker-compose.ollama.yml ativa o endereço interno automaticamente.
DENKYNHO_OLLAMA_DOCKER=false
DENKYNHO_LLM_MODEL=qwen3.5:4b
DENKYNHO_LLM_TIMEOUT=120
# Quando DENKYNHO_LLM_PROVIDER=remote: URL base (…/v1) e chave do provedor.
DENKYNHO_LLM_API_URL=
DENKYNHO_LLM_API_KEY=
# Embeddings (MiniLM). Em produção o padrão do settings costuma ser false.
DENKYNHO_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
